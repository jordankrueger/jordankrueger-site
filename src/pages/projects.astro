---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AREAS, FEATURED_ORDER, getProjects } from '../lib/project-areas';

const all = await getProjects();
const featured = (col: keyof typeof FEATURED_ORDER) => FEATURED_ORDER[col].map(title => {
  const entry = all.find(e => e.title === title && e.featuredIn.includes(col));
  if (!entry?.short) throw new Error(`Featured entry "${title}" missing for column "${col}"`);
  return entry;
});

// Colors come from the site tokens; stroke attributes sit on the paths (no CSS class).
const columns = [
  ...Object.entries(AREAS).map(([key, a]) => ({ key, heading: a.heading, intro: a.intro, href: a.path, all: a.all })),
  { key: 'ai', heading: 'Built with AI', intro: "I'm not a developer. I built all of this anyway.", href: '/ai', all: 'Read the story and every build' },
];

const tools = [
  { label: 'Sites: Astro' },
  { label: 'Hosting: Cloudflare Pages' },
  { label: 'Domains: Namecheap' },
  { label: 'Graphics: Canva' },
  { label: 'Email: Listmonk' },
  { label: 'Automation: n8n' },
  { label: 'AI: Claude Code & Codex' },
];
---

<BaseLayout title="Projects — Jordan Krueger" description="Things I've started, run or built, in four parts of my life.">
  <section class="section hub-head">
    <div class="container">
      <h1>Projects</h1>
      <p class="hub-lede">Things I've started, run or built, in four parts of my life.</p>
      <div class="guide">
        {columns.map(col => (
          <div class="col">
            {col.key === 'movement' && (
              <svg class="icon" viewBox="0 0 56 56" aria-hidden="true">
                <circle cx="20" cy="22" r="10" fill="var(--color-bg-warm)" />
                <path pathLength="1" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M8 46h40" />
                <path pathLength="1" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M28 46V30c0-6 5-11 12-11 0 7-5 11-12 11" />
                <path pathLength="1" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M28 36c-5 0-9-3-9-8 5 0 9 3 9 8" />
              </svg>
            )}
            {col.key === 'starbase' && (
              <svg class="icon" viewBox="0 0 56 56" aria-hidden="true">
                <path d="M8 12h18v6H14a6 6 0 0 0-6 6z" fill="var(--color-sun)" />
                <rect x="8" y="26" width="6" height="18" fill="var(--color-panel-cell)" />
                <rect x="18" y="38" width="14" height="6" fill="var(--color-sprout)" />
                <rect x="35" y="38" width="13" height="6" fill="var(--color-sun)" />
                <rect x="29" y="12" width="19" height="6" fill="var(--color-panel-cell)" />
              </svg>
            )}
            {col.key === 'personal' && (
              <svg class="icon" viewBox="0 0 56 56" aria-hidden="true">
                <path pathLength="1" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M10 28 28 12l18 16" />
                <path pathLength="1" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M15 24v20h26V24" />
                <rect x="23" y="32" width="10" height="12" fill="var(--color-bg-green)" />
                <circle cx="42" cy="14" r="5" fill="var(--color-sun)" />
              </svg>
            )}
            {col.key === 'ai' && (
              <svg class="icon" viewBox="0 0 56 56" aria-hidden="true">
                <path pathLength="1" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M8 44h14V30h14V16" />
                <circle cx="22" cy="44" r="3" fill="var(--color-bg)" stroke="var(--color-accent)" stroke-width="2" />
                <circle cx="36" cy="30" r="3" fill="var(--color-bg)" stroke="var(--color-accent)" stroke-width="2" />
                <path d="M36 16c0-6 5-10 12-10 0 7-5 10-12 10z" fill="var(--color-sprout)" />
              </svg>
            )}
            <h2>{col.heading}</h2>
            <p class="what">{col.intro}</p>
            <ul role="list">
              {featured(col.key as keyof typeof FEATURED_ORDER).map(item => (
                <li>
                  {col.key === 'ai' && item.href
                    ? <a href={item.href} target="_blank" rel="noopener"><b>{item.title}</b></a>
                    : <b>{item.title}</b>}
                  <span>{item.short}</span>
                </li>
              ))}
            </ul>
            <a class="all" href={col.href}>{col.all}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Description + Tools -->
  <section class="section projects-desc-section">
    <div class="container projects-desc">
      <div class="projects-desc-text">
        <p>I've always been drawn to new tools and technologies — especially the ones that feel just a little bit ahead of their time, and I've never quite been able to resist the urge to try things for myself. That impulse runs deep: my dad was an entrepreneur, and I grew up watching him chase ideas and take risks! I think that shaped me more than I realized.</p>
        <p>This page is where I keep track of the projects I've started outside my core consulting work — experiments, tools, and resources sparked by a mix of curiosity, admiration, and a deep love for what's possible when people build with purpose.</p>
        <p>Some projects are polished, some are scrappy, but all come from that same drive to explore what's next and put it into practice.</p>
      </div>
      <div class="tools-sidebar">
        <h3>Favorite tools</h3>
        <ul class="tools-list">
          {tools.map(tool => (
            <li class="tool-item">{tool.label}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Elsewhere on this site -->
  <section class="elsewhere-row">
    <div class="container">
      <h4>Elsewhere on this site</h4>
      <ul class="elsewhere-links">
        <li><a href="/ai">AI Showcase</a></li>
        <li><a href="/tools">Free Tools</a></li>
        <li><a href="/blog">Writing</a></li>
        <li><a href="https://campaign.help" target="_blank" rel="noopener">CampaignHelp ↗</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hub-head { padding-top: var(--spacing-xl); }
  .hub-head h1 { font-size: var(--fs-page-title); margin-bottom: 0.6rem; }
  .hub-lede { max-width: 38rem; margin-bottom: var(--spacing-lg); font-size: 1.1rem; }

  .guide {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .col {
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.4rem 1.3rem 1.2rem;
    display: flex;
    flex-direction: column;
  }
  .icon { width: 3.5rem; height: 3.5rem; display: block; }

  /* Drawings grow in as they scroll into view; unsupported or reduced motion = shown complete. */
  @supports (animation-timeline: view()) {
    @media screen and (prefers-reduced-motion: no-preference) {
      .icon path[fill="none"] {
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        animation: draw linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 100%;
      }
      .icon :is(circle, rect, path):not([fill="none"]) {
        transform-box: fill-box;
        transform-origin: 50% 100%;
        animation: grow linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 100%;
      }
    }
  }
  @keyframes grow { from { opacity: 0; transform: scale(.4); } to { opacity: 1; transform: none; } }
  .col h2 { font-size: 1.2rem; margin: 0.9rem 0 0.25rem; letter-spacing: -0.01em; }
  .what { font-size: 0.9rem; margin-bottom: 1rem; min-height: 2.8em; }
  .col ul { list-style: none; padding: 0; margin: 0 0 1rem; border-top: 1px solid var(--color-border); }
  .col li { padding: 0.6rem 0; border-bottom: 1px solid var(--color-border); font-size: 0.92rem; line-height: 1.45; }
  .col li b { display: block; color: var(--color-text-logo); font-weight: 700; }
  .col li a { text-decoration: none; }
  .col li a:hover b { text-decoration: underline; }
  .col li span { display: block; font-size: 0.84rem; }
  .all { margin-top: auto; font-weight: 700; font-size: 0.92rem; }
  .all::after { content: " →"; }

  @media (max-width: 900px) {
    .guide { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .guide { grid-template-columns: 1fr; }
  }

  .projects-desc-section {
    padding-top: var(--spacing-xl);
  }

  .projects-desc {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--spacing-lg);
    align-items: start;
  }

  .tools-sidebar {
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
  }

  .tools-sidebar h3 {
    font-family: var(--font-heading);
    margin-bottom: var(--spacing-sm);
  }

  .tools-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tool-item {
    padding: 0.5rem 0.75rem;
    background: var(--color-bg-green);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .projects-desc {
      grid-template-columns: 1fr;
    }
  }

  /* Elsewhere on this site */
  .elsewhere-row {
    margin-top: var(--spacing-2xl);
    padding: var(--spacing-xl) 0;
    border-top: 2px solid var(--color-border);
  }
  .elsewhere-row h4 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-light);
    margin-bottom: var(--spacing-sm);
    font-weight: 700;
  }
  .elsewhere-links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
  }
  .elsewhere-links li {
    margin: 0;
  }
  .elsewhere-links a {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
  }
</style>
