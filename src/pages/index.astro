---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CircuitDivider from '../components/CircuitDivider.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import ContactForm from '../components/ContactForm.astro';
import BlogPostCard from '../components/BlogPostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Jordan Krueger: Operations nerd, tech translator.">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Jordan Krueger",
    "url": "https://jordankrueger.com",
    "jobTitle": "Founder & CEO",
    "worksFor": {
      "@type": "Organization",
      "name": "CampaignHelp"
    },
    "sameAs": [
      "https://bsky.app/profile/jordankrueger.com",
      "https://www.linkedin.com/in/jordankrueger/"
    ]
  })} />
  <Hero />
  <CircuitDivider />

  <NewsletterSignup />

  <!-- Practices -->
  <section class="practices-band bg-green">
  <h2 class="section-heading practices-heading fade-up">Two practices I run</h2>
  <div class="panel-wrap">
    <div class="diptych-grid fade-up">
        <div class="diptych-half">
          <span class="practice-kicker">My consultancy</span>
          <h3>CampaignHelp</h3>
          <p>Fractional tech and operations for progressive nonprofits. Whatever piece your team can't get to — websites, AI workflows, security setup, infrastructure rescue.</p>
          <ul class="practice-services">
            <li><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Websites</li>
            <li><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>AI workflows</li>
            <li><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Security setup</li>
            <li><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Fractional support</li>
          </ul>
          <a href="https://campaign.help" target="_blank" rel="noopener" class="btn btn-primary practice-cta">See how I help →</a>
        </div>
        <div class="diptych-half">
          <span class="practice-kicker gah">Coming soon · my second practice</span>
          <h3>Grounded AI</h3>
          <p>AI talks, workshops, and advisory for operations leaders at mid-sized nonprofits and associations. Launching later this summer.</p>
          <ul class="practice-services">
            <li><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Speaking</li>
            <li><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Workshops</li>
            <li><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>Advisory</li>
          </ul>
          <a href="https://groundedai.help" target="_blank" rel="noopener" class="btn btn-outline practice-cta">Get notified at launch →</a>
        </div>
    </div>
  </div>
  </section>

  <!-- About Preview -->
  <div class="panel-wrap">
    <section class="about-panel fade-up">
      <h2 class="about-heading">About me</h2>
      <hr class="section-rule about-rule" />
      <div class="about-body">
        <p>Hi, I'm Jordan. I run <a href="https://campaign.help">CampaignHelp</a>, where I help progressive nonprofits and advocacy organizations stop wrestling with their technology — ActionKit, Google Workspace, tool migrations, workflow automation, and everything in between.</p>
        <p>I've worked with Win Without War, 350.org, Color Of Change, MomsRising, and others. Nearly two decades in the progressive movement means I already know your tools, your campaign cycle, and your budget constraints.</p>
        <a href="/about" class="read-more">Read my full story →</a>
      </div>
    </section>
  </div>

  <CircuitDivider />

  <!-- Recent Blog Posts -->
  <section class="section">
    <div class="container">
      <h2 class="section-heading fade-up">My recent blog posts</h2>
      {posts.length > 0 ? (
        <div class="posts-grid">
          {posts.map((post, i) => (
            <div class={`post-item fade-up delay-${Math.min(i + 1, 4)}`}>
              <BlogPostCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                slug={post.id}
                coverImage={post.data.coverImage}
                tags={post.data.tags}
              />
            </div>
          ))}
        </div>
      ) : (
        <p class="placeholder-text">Blog posts coming soon. Stay tuned!</p>
      )}
      <div class="center-link fade-up">
        <a href="/blog" class="btn btn-outline">Read more</a>
      </div>
    </div>
  </section>

  <div class="fade-up">
    <ContactForm />
  </div>
</BaseLayout>

<style>
  :root {
    --color-gah-accent: var(--color-sun-text);
  }

  .section-heading {
    text-align: center;
    margin-bottom: var(--spacing-lg);
  }

  .practices-band {
    padding: var(--spacing-xl) 0;
  }

  .practices-heading {
    margin-bottom: var(--spacing-md);
  }

  .panel-wrap {
    padding: 0 var(--spacing-md);
  }

  .about-panel {
    max-width: var(--max-width);
    margin: var(--spacing-xl) auto;
    background-color: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
  }

  /* Practices: two cards side by side */
  .diptych-grid {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto 1fr auto auto;
    column-gap: var(--spacing-md);
  }

  .diptych-half {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: 1 / 6;
    gap: 0.85rem;
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.6rem 1.75rem 1.75rem;
  }

  .diptych-half h3 {
    font-size: 1.85rem;
    line-height: 1.1;
    margin: 0;
  }

  .diptych-half p {
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--color-text);
    margin: 0;
  }

  .practice-kicker {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--color-accent);
    font-weight: 600;
    margin: 0;
  }
  .practice-kicker.gah {
    color: var(--color-gah-accent);
  }

  .practice-services {
    list-style: none;
    padding: 0;
    margin: 0.4rem 0 0;
    display: grid;
    align-content: start;
    gap: 0.4rem;
  }

  .practice-services li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
  }

  .practice-services svg {
    flex: none;
  }

  .practice-cta {
    margin-top: 0.3rem;
    justify-self: start;
    align-self: start;
    text-decoration: none;
  }

  /* Fallback for browsers without subgrid */
  @supports not (grid-template-rows: subgrid) {
    .diptych-half {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }
    .diptych-half p { flex: 1 0 auto; }
  }

  /* About Preview */
  .about-heading {
    text-align: center;
  }

  .about-rule {
    margin: 0 auto var(--spacing-md);
  }

  .about-body {
    max-width: 640px;
    margin: 0 auto;
    text-align: left;
  }

  .read-more {
    display: inline-block;
    margin-top: var(--spacing-sm);
    font-weight: 500;
  }

  /* Posts Grid */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-md);
    position: relative;
    padding-top: 1.6rem; /* room for the vine */
  }

  /* Vine: a line across the top of the row, a node above each card */
  .post-item { position: relative; }
  .posts-grid::before {
    content: '';
    position: absolute;
    top: 0.4rem;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-sprout);
    opacity: 0.6;
  }
  .post-item::before {
    content: '';
    position: absolute;
    top: -1.6rem;
    left: 1.5rem;
    width: 0.8rem;
    height: 0.8rem;
    box-sizing: border-box;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2.5px solid var(--color-accent);
  }

  .placeholder-text {
    text-align: center;
    color: var(--color-text-light);
    font-style: italic;
    margin-bottom: var(--spacing-md);
  }

  .center-link {
    text-align: center;
    margin-top: var(--spacing-md);
  }

  @media (max-width: 900px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
      padding-top: 0;
    }
    /* The vine only reads as one row; once cards wrap, drop it. */
    .posts-grid::before,
    .post-item::before {
      display: none;
    }
    .diptych-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      row-gap: var(--spacing-md);
    }
    .diptych-half {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      grid-row: auto;
    }
  }

  @media (max-width: 640px) {
    .about-panel {
      padding: var(--spacing-md) var(--spacing-sm);
    }
    .diptych-half {
      padding: var(--spacing-md) var(--spacing-sm);
    }
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
