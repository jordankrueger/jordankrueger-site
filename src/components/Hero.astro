---
import SocialIcons from './SocialIcons.astro';
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-text">
      <h1 class="hero-greeting fade-up">Hiya &amp; <span class="hl">welcome!</span></h1>
      <p class="hero-intro fade-up delay-1">I'm Jordan: Operations nerd, tech translator.</p>
      <p class="hero-sub fade-up delay-2">I help progressive orgs cut through the noise, simplify their systems, and get back to the work that matters.</p>
      <div class="hero-actions fade-up delay-3">
        <a href="/about" class="btn btn-primary">Learn more</a>
        <a href="https://calendly.com/campaignhelp/30min" class="btn btn-outline" target="_blank" rel="noopener">Hire me</a>
      </div>
      <div class="fade-up delay-4">
        <SocialIcons />
      </div>
    </div>
    <div class="hero-image fade-up delay-2">
      <div class="hero-photo">
        <svg class="hero-art" viewBox="0 0 128 128" aria-hidden="true" focusable="false">
          <circle class="sun" cx="104" cy="22" r="20" fill="var(--color-sun)" />
          <g transform="translate(4 86) rotate(-12)">
            <rect x="0" y="0" width="38" height="24" rx="3" fill="var(--color-panel)" />
            <g class="cells" fill="var(--color-panel-cell)">
              <rect style="--i:0" x="3" y="3" width="10" height="8" rx="1" /><rect style="--i:1" x="14" y="3" width="10" height="8" rx="1" /><rect style="--i:2" x="25" y="3" width="10" height="8" rx="1" />
              <rect style="--i:3" x="3" y="13" width="10" height="8" rx="1" /><rect style="--i:4" x="14" y="13" width="10" height="8" rx="1" /><rect style="--i:5" x="25" y="13" width="10" height="8" rx="1" />
            </g>
          </g>
          <path class="line wire" pathLength="1" d="M30 116 H70 V122 H112 V100" fill="none" stroke="var(--color-accent)" stroke-linecap="round" stroke-linejoin="round" />
          <circle class="line node n1" cx="70" cy="116" r="1.8" fill="var(--color-bg)" stroke="var(--color-accent)" />
          <circle class="line node n2" cx="112" cy="122" r="1.8" fill="var(--color-bg)" stroke="var(--color-accent)" />
          <g class="leaf">
            <path d="M112 100 c0-9 6-14 15-14 0 9-6 14-15 14z" fill="var(--color-sprout)" />
            <path class="line" d="M112 100 c4-4 8-8 12-11" fill="none" stroke="var(--color-accent)" stroke-linecap="round" />
          </g>
        </svg>
        <img class="photo" src="/images/headshot-hero.jpg" alt="Jordan Krueger" width="1200" height="1200" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero { background: var(--color-bg); padding: var(--spacing-xl) 0 var(--spacing-2xl); overflow-x: clip; }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    align-items: center;
  }

  .hero-greeting { margin-bottom: var(--spacing-sm); }
  .hero-greeting .hl { color: var(--color-accent); }

  .hero-intro {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-text-logo);
    margin-bottom: var(--spacing-xs);
  }

  .hero-sub {
    font-size: 1.05rem;
    color: var(--color-text);
    max-width: 32rem;
    margin-bottom: var(--spacing-md);
  }

  .hero-actions {
    display: flex;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }

  .hero-photo { position: relative; isolation: isolate; width: 100%; max-width: 440px; aspect-ratio: 1; margin-left: auto; }
  .hero-photo img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; display: block; }
  .hero-art { position: absolute; inset: -12% -12% -14% -16%; z-index: -1; overflow: visible; }
  .hero-art .line { vector-effect: non-scaling-stroke; stroke-width: 2.5px; }

  /* One sequence on load (about 2 s), then still. Reduced motion = finished drawing. */
  @media (prefers-reduced-motion: no-preference) {
    .sun { transform-box: fill-box; transform-origin: center; animation: sunrise 900ms var(--ease-out) both; }
    .cells rect { animation: cell var(--dur-long) var(--ease-out) both; animation-delay: calc(500ms + var(--i) * 70ms); }
    .wire { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 900ms var(--ease-in-out) 700ms forwards; }
    .node { transform-box: fill-box; transform-origin: center; animation: pop 250ms var(--ease-out) both; }
    .n1 { animation-delay: 1000ms; }
    .n2 { animation-delay: 1350ms; }
    .leaf { transform-box: fill-box; transform-origin: 0% 100%; animation: unfurl 600ms var(--ease-out) 1500ms both; }
    .photo { animation: fadein 600ms var(--ease-out) both; }
  }
  @keyframes sunrise { from { opacity: 0; transform: translateY(40%) scale(.7); } to { opacity: 1; transform: none; } }
  @keyframes cell { from { fill: var(--color-panel-cell); } 60% { fill: var(--color-sun); } to { fill: var(--color-panel-cell); } }
  @keyframes pop { from { opacity: 0; transform: scale(0); } to { opacity: 1; transform: none; } }
  @keyframes fadein { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  @media (max-width: 640px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-image {
      order: -1;
    }

    .hero-photo { max-width: 16rem; margin: 0 auto var(--spacing-md); }

    .hero :global(.social-icons) {
      justify-content: center;
    }
  }
</style>
