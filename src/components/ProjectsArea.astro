---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';
import fileOrder from '../content/projects.json';
import { AREAS, type AreaKey } from '../lib/project-areas';

interface Props { area: AreaKey }
const { area } = Astro.props;
const { heading, intro } = AREAS[area];

// getCollection does not keep file order; the JSON order is the page order.
const rank = (id: string) => fileOrder.findIndex(e => e.id === id);
const entries = (await getCollection('projects'))
  .filter(e => e.data.areas.includes(area))
  .sort((a, b) => rank(a.id) - rank(b.id));
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
---

<BaseLayout title={`${heading} — Projects — Jordan Krueger`} description={intro}>
  <section class="section bg-green">
    <div class="container">
      <a href="/projects" class="area-back">← Back to Projects</a>
      <h1>{heading}</h1>
      <p class="area-intro">{intro}</p>
    </div>
  </section>

  {entries.map(({ data }, i) => (
    <ProjectCard
      title={data.title}
      description={data.body ?? `<p>${escape(data.aiDescription ?? '')}</p>`}
      image={data.image}
      href={data.href}
      linkLabel={data.linkLabel}
      secondaryLinks={data.secondaryLinks}
      index={i}
    />
  ))}
</BaseLayout>

<style>
  .area-back {
    display: inline-block;
    margin-bottom: var(--spacing-sm);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .area-intro {
    font-size: 1.1rem;
    margin-top: 0.75rem;
  }
  h1 {
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
  }
</style>
