---
interface Props {
  variant?: 'default' | 'compact';
  id?: string;
  // Optional copy and bonus overrides (e.g. the Starter Pack form in Part 2 of Own Your Corner).
  bonus?: string;
  label?: string;
  title?: string;
  desc?: string;
  button?: string;
  success?: string;
}
const {
  variant = 'default',
  id = 'subscribe',
  bonus,
  label = 'Subscribe to',
  title = 'Mission Control ➡️',
  desc = "I share thoughts on online tools, learnings from my nonprofit advocacy consulting business, projects I'm launching, Artificial Intelligence, and personal updates — directly to your inbox.",
  button = 'Subscribe',
  success = "You're on the list. Thanks!",
} = Astro.props;
---

<div class:list={["newsletter-wrap", variant]} id={id}>
  <section class:list={["newsletter-panel", variant]}>
    <div class="newsletter-inner">
      <div class="newsletter-text">
        <p class="newsletter-label">{label}</p>
        <p class="newsletter-title">{title}</p>
        <hr class="newsletter-divider" />
      </div>
      <div class="newsletter-form-wrap">
        <p class="newsletter-desc">{desc}</p>
        <form method="post" action="https://progressives-signup.restless-salad-a31e.workers.dev" class="newsletter-form" data-success={success}>
          <label class="sr-only" for={`newsletter-email-${id}`}>Email address</label>
          <input type="email" id={`newsletter-email-${id}`} name="email" placeholder="Your email" required maxlength="256" autocomplete="email" />
          <input type="hidden" name="list" value="mission-control" />
          {bonus && <input type="hidden" name="bonus" value={bonus} />}
          <button type="submit" class="btn btn-primary">{button}</button>
          <div
            id={`newsletter-turnstile-${id}`}
            class="cf-turnstile"
            data-sitekey="0x4AAAAAAENA2SSitXnnEAkn"
            data-action="newsletter"
            data-appearance="interaction-only"
            data-size="compact"
            data-theme="auto"
          ></div>
        </form>
        <p class="newsletter-status" hidden></p>
      </div>
    </div>
  </section>
</div>

<style>
  /* Default variant: full-width band (no padding on wrap, border-top/bottom only) */
  .newsletter-wrap {
    padding: 0;
  }

  .newsletter-wrap.compact {
    padding: var(--spacing-md) var(--spacing-md);
  }

  .newsletter-panel {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: var(--spacing-lg);
    background-color: var(--color-bg-white);
  }

  .newsletter-panel.compact {
    max-width: var(--max-width);
    margin: 0 auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg-peach);
  }

  .newsletter-inner {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    max-width: var(--max-width);
    margin: 0 auto;
    flex-wrap: wrap;
  }

  .newsletter-text {
    flex: 1;
    min-width: 260px;
  }

  .newsletter-form-wrap {
    flex: 1;
    min-width: 280px;
  }

  .newsletter-label {
    font-size: 0.9rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }

  .newsletter-title {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
  }

  .newsletter-divider {
    border: none;
    border-top: 2px solid var(--color-border);
    margin-top: var(--spacing-sm);
    width: 60px;
  }

  .newsletter-desc {
    font-size: 0.95rem;
    margin-bottom: var(--spacing-sm);
  }

  .newsletter-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .newsletter-form .cf-turnstile {
    flex-basis: 100%;
  }

  .newsletter-form input {
    flex: 1;
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-size: 0.95rem;
    background: var(--color-bg-white);
  }

  .newsletter-form input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: -1px;
    border-color: var(--color-accent);
  }

  .newsletter-status {
    font-size: 0.9rem;
    margin-top: 0.6rem;
    text-align: left;
  }

  .newsletter-status.success {
    color: var(--color-success);
  }

  .newsletter-status.error {
    color: var(--color-error);
  }

  @media (max-width: 640px) {
    .newsletter-wrap.compact {
      padding: var(--spacing-md) var(--spacing-sm);
    }

    .newsletter-panel {
      padding: var(--spacing-md) var(--spacing-lg);
    }

    .newsletter-panel.compact {
      padding: var(--spacing-md) var(--spacing-sm);
      border-radius: var(--radius-md);
    }

    .newsletter-inner {
      gap: var(--spacing-md);
    }

    .newsletter-form {
      flex-direction: column;
    }
  }
</style>

<script>
  import '../scripts/newsletter-form.ts';
</script>
