---
// Tip jar: two plain links, no third-party scripts, so the CSP in public/_headers does not change.
// PLACEHOLDERS: replace both URLs before merging. .invalid is a reserved domain, so a
// placeholder can never send money to a stranger. Set a URL to '' to drop that button.
const VENMO_URL: string = 'https://example.invalid/YOUR-VENMO-PROFILE-LINK';
const KOFI_URL: string = 'https://example.invalid/YOUR-KOFI-PAGE';

const links = [
  { href: VENMO_URL, label: 'Tip me on Venmo', style: 'btn-primary' },
  { href: KOFI_URL, label: 'Buy me a coffee on Ko-fi', style: 'btn-outline' },
].filter(link => link.href);

const isPlaceholder = links.some(link => link.href.includes('.invalid'));
---

{links.length > 0 && (
  <aside class="support" aria-labelledby="support-heading">
    <h2 id="support-heading">Tip jar</h2>
    <p>My writing here is free. If something helped you and you'd like to say thanks, you can send me a tip.</p>
    <ul class="support-actions" role="list">
      {links.map(link => (
        <li>
          <a class={`btn ${link.style}`} href={link.href} target="_blank" rel="noopener">
            {link.label}
            <svg class="support-ext" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 9 9 3M3 3h6v6" /></svg>
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </li>
      ))}
    </ul>
    {VENMO_URL && <p class="support-note">Venmo only works in the US.</p>}
    {isPlaceholder && <p class="support-placeholder">Mockup: these links are placeholders and go nowhere.</p>}
  </aside>
)}

<style>
  .support {
    max-width: var(--measure, 68ch);
    margin: var(--spacing-lg) auto 0;
    padding: var(--spacing-md);
    background: var(--color-bg-warm);
    border: 1px solid var(--color-sun-border);
    border-radius: var(--radius-md);
  }

  .support h2 {
    margin: 0 0 var(--spacing-xs);
    font-size: 1.35rem;
  }

  .support p { margin: 0; }

  .support-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs) var(--spacing-sm);
    list-style: none;
    padding: 0;
    margin: var(--spacing-sm) 0;
  }

  .support-actions .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
  }

  /* White fill so the outline button reads on the warm band (same approach as DiscussionBar) */
  .support-actions .btn-outline { background-color: var(--color-bg-white); }
  .support-actions .btn-outline:hover {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .support-ext {
    width: 0.7rem;
    height: 0.7rem;
    flex: none;
  }

  .support-note {
    font-size: 0.85rem;
    color: var(--color-text-light);
  }

  .support .support-placeholder {
    margin-top: var(--spacing-xs);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-error);
  }

  @media (max-width: 640px) {
    .support-actions { flex-direction: column; }
    .support-actions .btn { display: flex; white-space: normal; }
  }
</style>
