---
interface Props {
  title: string;
  description: string;
  tags: string[];
  status: string;
  statusType: 'live' | 'deployed' | 'active' | 'complete';
}

const { title, description, tags, status, statusType } = Astro.props;
// First sentence for the closed row; the full text shows when the row opens.
// A closing quote can follow the end punctuation ("…today?" Then…).
const first = description.match(/^.*?[.!?]["'”’)]*(?=\s|$)/)?.[0] ?? description;
---

<details class="ai-row">
  <summary>
    <b>{title}</b>
    <span class="ai-row-first">{first}</span>
    <span class:list={["ai-status", `ai-status-${statusType}`]}>{status}</span>
  </summary>
  <div class="ai-row-detail">
    <p>{description}</p>
    <div class="ai-row-tags">
      {tags.map(tag => <span class="ai-tag">{tag}</span>)}
    </div>
  </div>
</details>

<style>
  .ai-row {
    border-bottom: 1px solid var(--color-border);
  }

  .ai-row[open] {
    background: var(--color-bg-white);
    border-radius: var(--radius-sm);
    border-bottom-color: transparent;
  }

  summary {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr) auto 1rem;
    gap: var(--spacing-sm);
    align-items: baseline;
    padding: 0.65rem 0.5rem;
    cursor: pointer;
    list-style: none;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-right: 2px solid var(--color-accent);
    border-bottom: 2px solid var(--color-accent);
    transform: rotate(45deg);
    align-self: center;
    justify-self: end;
    transition: transform 0.2s ease;
  }

  .ai-row[open] summary::after {
    transform: rotate(-135deg);
  }

  summary b {
    color: var(--color-text-logo);
    font-weight: 700;
  }

  .ai-row-detail {
    padding: 0 0.5rem 0.9rem;
  }

  .ai-row-detail p {
    font-size: 0.9rem;
    line-height: 1.65;
    margin-bottom: 0.75rem;
  }

  .ai-row-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .ai-tag {
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.2rem 0.625rem;
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text-light);
  }

  .ai-status {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  .ai-status-live,
  .ai-status-deployed {
    background: var(--color-bg-green);
    color: var(--color-accent);
  }

  .ai-status-active {
    background: var(--color-bg-warm);
    color: var(--color-sun-text);
  }

  .ai-status-complete {
    background: var(--color-bg-blue);
    color: var(--color-panel);
  }

  @media (max-width: 760px) {
    summary {
      grid-template-columns: minmax(0, 1fr) auto 1rem;
    }

    .ai-row-first {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
