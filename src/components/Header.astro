---
import LogoMark from './LogoMark.astro';

const navLinks = [
  { href: '/blog', label: 'Blog' },
  { href: '/projects', label: 'Projects', children: [
    { href: '/projects', label: 'All projects' },
    { href: '/projects/movement', label: 'Movement work' },
    { href: '/projects/starbase-118', label: 'StarBase 118' },
    { href: '/projects/personal', label: 'Personal tools' },
    { href: '/ai', label: 'Built with AI' },
    { href: '/tools', label: 'Tools for progressives' },
  ] },
  { href: '/about', label: 'About' },
  { href: 'https://campaign.help', label: 'CampaignHelp', external: true },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const projectsActive = ['/projects', '/ai', '/tools'].some(path => currentPath.startsWith(path));
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo"><LogoMark /><span>Jordan Krueger</span></a>

    <nav class="desktop-nav" aria-label="Main navigation">
      {navLinks.map(link => link.children ? (
        <div class="nav-group">
          <button class:list={['nav-link', 'nav-group-btn', { active: projectsActive }]} aria-expanded="false" aria-controls="projects-menu">
            {link.label}
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m3 4.5 3 3 3-3" /></svg>
          </button>
          <ul id="projects-menu">
            {link.children.map(child => <li><a href={child.href} aria-current={currentPath === child.href ? 'page' : undefined}>{child.label}</a></li>)}
          </ul>
        </div>
      ) : (
        <a
          href={link.href}
          class:list={["nav-link", { active: !link.external && currentPath.startsWith(link.href) }]}
          {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
        >
          {link.label}
          {link.external && <><svg class="ext-icon" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 9 9 3M3 3h6v6" /></svg><span class="sr-only">(opens in a new tab)</span></>}
        </a>
      ))}
    </nav>

    <a href="/#subscribe" class="subscribe-pill desktop-only">Subscribe</a>

    <button class="mobile-menu-btn" aria-label="Open menu" aria-expanded="false">
      <span class="hamburger"></span>
    </button>
  </div>

  <!-- Mobile nav overlay -->
  <div class="mobile-nav-overlay" aria-hidden="true">
    <nav class="mobile-nav" aria-label="Mobile navigation">
      {navLinks.map(link => link.children ? (
        <div class="mobile-nav-group">
          <span class="mobile-nav-label">{link.label}</span>
          {link.children.map(child => <a href={child.href} class="mobile-nav-link" aria-current={currentPath === child.href ? 'page' : undefined}>{child.label}</a>)}
        </div>
      ) : (
        <a
          href={link.href}
          class:list={["mobile-nav-link", { active: !link.external && currentPath.startsWith(link.href) }]}
          {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
        >
          {link.label}
          {link.external && <><svg class="ext-icon" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 9 9 3M3 3h6v6" /></svg><span class="sr-only">(opens in a new tab)</span></>}
        </a>
      ))}
      <a href="/#subscribe" class="mobile-nav-link">Subscribe</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
    gap: 1.5rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: -0.01em;
    color: var(--color-text-logo);
    text-decoration: none;
    white-space: nowrap;
  }

  .logo:hover { color: var(--color-accent); }

  .desktop-nav {
    display: flex;
    gap: 1.5rem;
  }

  .nav-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    padding: 0.25rem 0;
    border-bottom: 2px solid transparent;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-accent);
    border-bottom-color: var(--color-sun);
  }

  .nav-group { position: relative; }

  .nav-group-btn {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: inherit;
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    cursor: pointer;
  }

  #projects-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: -1rem;
    min-width: 13rem;
    margin: 0;
    padding: 0.5rem;
    list-style: none;
    background: var(--color-bg-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
  }

  :global(html.js) .nav-group-btn[aria-expanded="true"] + #projects-menu,
  :global(html:not(.js)) .nav-group:hover #projects-menu,
  :global(html:not(.js)) .nav-group:focus-within #projects-menu { display: block; }

  #projects-menu a {
    display: block;
    padding: 0.55rem;
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  #projects-menu a:hover,
  #projects-menu a[aria-current="page"] { background: var(--color-bg-warm); color: var(--color-accent); }

  .ext-icon { width: 0.8em; height: 0.8em; margin-left: 0.2em; }

  .subscribe-pill {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-accent);
    background: var(--color-bg-warm);
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    text-decoration: none;
  }

  .subscribe-pill:hover {
    background: var(--color-sun);
    color: var(--color-text-logo);
  }

  .desktop-only {
    display: block;
  }

  /* Mobile menu button */
  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .hamburger {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text-logo);
    position: relative;
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
    width: 22px;
    height: 2px;
    background: var(--color-text-logo);
  }

  .hamburger::before { top: -7px; }
  .hamburger::after { top: 7px; }

  /* Open state */
  .mobile-menu-btn[aria-expanded="true"] .hamburger {
    background: transparent;
  }

  .mobile-menu-btn[aria-expanded="true"] .hamburger::before {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .mobile-menu-btn[aria-expanded="true"] .hamburger::after {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* Mobile nav overlay */
  .mobile-nav-overlay {
    display: none;
    position: fixed;
    inset: 4rem 0 0;
    background: var(--color-bg);
    z-index: 99;
    padding: var(--spacing-lg) var(--spacing-md);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mobile-nav-overlay[aria-hidden="false"] {
    display: block;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-nav-link {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active,
  .mobile-nav-link[aria-current="page"] {
    color: var(--color-accent);
  }

  .mobile-nav-group { display: flex; flex-direction: column; }
  .mobile-nav-label { padding: 0.75rem 0; font-size: 1.25rem; font-weight: 600; }
  .mobile-nav-group .mobile-nav-link { padding-left: 1rem; }

  @media (prefers-reduced-motion: no-preference) {
    .nav-link { transition: color 0.15s ease, border-color 0.15s ease; }
    .subscribe-pill { transition: background-color 0.15s ease, color 0.15s ease; }
    .hamburger { transition: background 0.2s ease; }
    .hamburger::before,
    .hamburger::after { transition: transform 0.2s ease; }
  }

  @media (max-width: 900px) {
    .desktop-nav,
    .desktop-only {
      display: none;
    }

    .mobile-menu-btn {
      display: block;
    }
  }
</style>

<script>
  const group = document.querySelector<HTMLElement>('.nav-group');
  const projectsBtn = group?.querySelector<HTMLButtonElement>('.nav-group-btn');

  if (group && projectsBtn) {
    let pinned = false;
    let leaveTimer: ReturnType<typeof setTimeout>;
    const closeProjects = () => {
      clearTimeout(leaveTimer);
      pinned = false;
      projectsBtn.setAttribute('aria-expanded', 'false');
    };

    projectsBtn.addEventListener('click', () => {
      if (pinned) closeProjects();
      else {
        pinned = true;
        projectsBtn.setAttribute('aria-expanded', 'true');
      }
    });
    group.addEventListener('pointerenter', () => {
      clearTimeout(leaveTimer);
      if (matchMedia('(hover: hover)').matches) projectsBtn.setAttribute('aria-expanded', 'true');
    });
    group.addEventListener('pointerleave', () => {
      leaveTimer = setTimeout(() => {
        if (!pinned && !group.contains(document.activeElement)) closeProjects();
      }, 150);
    });
    group.addEventListener('focusout', event => {
      if (!group.contains(event.relatedTarget as Node | null)) closeProjects();
    });
    group.addEventListener('keydown', event => {
      if (event.key === 'Escape') {
        closeProjects();
        projectsBtn.focus();
      }
    });
    document.addEventListener('click', event => {
      if (!group.contains(event.target as Node)) closeProjects();
    });
  }

  const menuBtn = document.querySelector('.mobile-menu-btn');
  const overlay = document.querySelector('.mobile-nav-overlay');

  menuBtn?.addEventListener('click', () => {
    const isOpen = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', String(!isOpen));
    overlay?.setAttribute('aria-hidden', String(isOpen));
    document.body.style.overflow = isOpen ? '' : 'hidden';
  });

  // Close on nav link click
  overlay?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menuBtn?.setAttribute('aria-expanded', 'false');
      overlay?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    });
  });
</script>
